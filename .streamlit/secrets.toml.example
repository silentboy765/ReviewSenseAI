# Copy these settings into Streamlit Community Cloud > App > Settings > Secrets.
# Never replace this example with real credentials in a public GitHub repository.
CLOUDFLARE_ACCOUNT_ID = "replace-with-your-account-id"
CLOUDFLARE_API_TOKEN = "replace-with-your-workers-ai-token"
CLOUDFLARE_MODEL = "@cf/ibm-granite/granite-4.0-h-micro"
